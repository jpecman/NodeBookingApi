{
  "name": "node-booking-api",
  "version": "0.1.0",
  "description": "NestJS port of BookingApi's Contact slice",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --selectProjects unit",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --selectProjects unit",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --selectProjects e2e --runInBand",
    "test:all": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --runInBand",
    "security": "./scripts/security-check.sh",
    "openapi:generate": "ts-node src/generate-openapi.ts",
    "migration:generate": "ts-node src/database/migrate.ts create",
    "migration:run": "ts-node src/database/migrate.ts up",
    "migration:revert": "ts-node src/database/migrate.ts down",
    "seed:auth-user": "ts-node src/database/seed-auth-user.ts",
    "seed:booking": "ts-node src/database/seed-booking.ts"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "unrs-resolver": false
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    },
    "multer": "^2.3.0"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.1.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
