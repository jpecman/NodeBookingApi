NODE_ENV=development
PORT=3000

# App connection string. Host port 5433 keeps this off BookingApi's Postgres on 5432.
DATABASE_URL=postgres://booking:booking@localhost:5433/nodebooking

# Consumed by docker-compose.yml when it starts the Postgres container.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=nodebooking
POSTGRES_PORT=5433
