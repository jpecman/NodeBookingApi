NODE_ENV=development
PORT=3000

# App connection string. Host port 5433 keeps this off BookingApi's Postgres on 5432.
DATABASE_URL=postgres://booking:booking@localhost:5433/nodebooking

# Consumed by docker-compose.yml when it starts the Postgres container.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=nodebooking
POSTGRES_PORT=5433

# NodeBookingApi-owned database for User/auth data — a separate database from DATABASE_URL
# above, not a separate schema. Real .env currently points this at a second database on
# the shared nunicek-ts Postgres instance (same server as BookingDb, different db name).
AUTH_DATABASE_URL=postgres://booking:booking@localhost:5433/nodebookingauth

# HS256 signing key for auth JWTs, carried in the httpOnly "token" cookie.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
