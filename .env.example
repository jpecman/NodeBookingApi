NODE_ENV=development
PORT=3000

# The one database: users, contacts, fields, pitches, bookings, slots.
# Host port 5433 keeps this off BookingApi's Postgres on 5432.
DATABASE_URL=postgres://booking:booking@localhost:5433/nodebooking

# Consumed by docker-compose.yml when it starts the Postgres container.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=nodebooking
POSTGRES_PORT=5433

# HS256 signing key for auth JWTs, carried in the httpOnly "token" cookie.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# The account `npm run seed:auth-user` provisions. There is no registration endpoint, so
# this is the only way in. SEED_PASSWORD has no default and the seed refuses to run without
# it — pick your own here; it never leaves your .env.
# SEED_EMAIL=admin@nodebooking.local
# SEED_PASSWORD=
# SEED_ROLE=Administrator   # SuperAdmin | Administrator | Content
